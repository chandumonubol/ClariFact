# ClariFact — Environment Variables
# See AGENTS.md for required reading order before modifying.

# Database
DATABASE_URL=postgresql://user:password@localhost:5452/clarifact

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
BCRYPT_LOG_ROUNDS=12

# AI/ML
AI_MODEL_PATH=models/claim_classifier.joblib

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_IMAGES=10485760  # 10MB in bytes
MAX_UPLOAD_SIZE_VIDEOS=52428800  # 50MB in bytes
MAX_VIDEO_DURATION_SECONDS=300   # 5 minutes

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False